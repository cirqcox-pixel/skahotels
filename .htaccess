# Disable directory listing
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Make index.php the default
  DirectoryIndex index.php

  #####################################
  # 1) Redirect requests that explicitly contain ".php" (except /forms/) to clean URL
  #####################################
  RewriteCond %{THE_REQUEST} \s(/(?!forms/).+?)\.php[?\s] [NC]
  RewriteRule ^ %1 [R=301,L]

  #####################################
  # 2) Serve existing files or directories directly
  #####################################
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  #####################################
  # 3) Internal rewrite to .php if file exists (except /forms/)
  #####################################
  RewriteCond %{REQUEST_URI} !^/forms/
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.php -f
  RewriteRule ^(.*)$ $1.php [L]

  #####################################
  # 4) Optional fallback to index.php (if desired)
  # RewriteRule ^.*$ /index.php [L,QSA]
  #####################################
</IfModule>
